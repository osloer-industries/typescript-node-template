{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["scripts/agent-hooks/block-guardrail-edits.ts"]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["scripts/agent-hooks/pre-stop-fast-check.ts"]
          }
        ]
      }
    ]
  }
}
