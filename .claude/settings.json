{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["scripts/agent-hooks/block-guardrail-edits.ts"]
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["scripts/agent-hooks/pre-stop-fast-check.ts"]
          }
        ]
      }
    ]
  }
}
